@@ -0,0 +1,15 @@
+internal import Darwin
+internal import Foundation
+
+/// Temporary research overlay: starting core of the process. Not shipping code.
+enum StartupProbe {
+    static func mark(_ phase: String) {
+        var cpuNumber: UInt = 0
+        let status = unsafe pthread_cpu_number_np(&cpuNumber)  // SAFETY: borrows one stack value for the call.
+        var usage = rusage()
+        _ = unsafe getrusage(RUSAGE_SELF, &usage)  // SAFETY: as above.
+        let cpu = (Int64(usage.ru_utime.tv_sec) + Int64(usage.ru_stime.tv_sec)) * 1_000_000
+            + Int64(usage.ru_utime.tv_usec) + Int64(usage.ru_stime.tv_usec)
+        FileHandle.standardError.write(Data("TRACE \(phase) 0 \(cpu) \(cpuNumber) \(qos_class_self().rawValue) 0 \(status)\n".utf8))
+    }
+}
