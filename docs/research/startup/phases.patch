diff --git a/Sources/ask/StartupProbe.swift b/Sources/ask/StartupProbe.swift
new file mode 100644
index 0000000..a0501e1
--- /dev/null
+++ b/Sources/ask/StartupProbe.swift
@@ -0,0 +1,22 @@
+internal import Darwin
+internal import Foundation
+
+/// Temporary startup sampling, not a shipping implementation.
+enum StartupProbe {
+    static let begin = ContinuousClock.now
+    static func mark(_ phase: String) {
+        let elapsed = begin.duration(to: .now).components
+        let nanos = elapsed.seconds * 1_000_000_000 + elapsed.attoseconds / 1_000_000_000
+        var usage = rusage()
+        var cpuNumber: UInt = 0
+        // SAFETY: both C calls borrow initialized stack values and retain neither pointer.
+        _ = unsafe getrusage(RUSAGE_SELF, &usage)
+        let cpuResult = unsafe pthread_cpu_number_np(&cpuNumber)
+        let cpu = (Int64(usage.ru_utime.tv_sec) + Int64(usage.ru_stime.tv_sec)) * 1_000_000
+            + Int64(usage.ru_utime.tv_usec) + Int64(usage.ru_stime.tv_usec)
+        let qos = qos_class_self().rawValue
+        let priority = Task.currentPriority.rawValue
+        FileHandle.standardError.write(
+            Data("TRACE \(phase) \(nanos) \(cpu) \(cpuNumber) \(qos) \(priority) \(cpuResult)\n".utf8))
+    }
+}
