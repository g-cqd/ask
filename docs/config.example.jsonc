// Every setting ask reads, with an example value. Generated from Sources/AskAgentCore/Configuration/SettingCatalog.swift:
// do not edit; `ASK_WRITE_EXAMPLE=1 swift test --filter SettingCatalogTests` writes it again.
// Copy only what you want to change into ~/.config/ask/config.json; see docs/configuration.md.
{

  // The model to use; /model changes it for the session. Default: the provider's default.
  "model": "a-model-id",

  // The connection to use. Default: the first account that can answer.
  "provider": "a-connection",

  // How much the model thinks. Default: default. One of: default, off, minimal, low, medium, high, xhigh, max.
  "thinking": "default",

  // The most model requests one prompt may make, or null for no limit. Default: 100 in the sandbox, no limit with --no-sandbox.
  "maxTurns": 100,

  // When the conversation is summarised: a share of the window up to 1, or a number of tokens. Default: 0.75.
  "compactAt": 0.75,

  // When ask keeps the Mac from sleeping. Default: working. One of: off, working, always.
  "keepAwake": "working",

  // Whether the display stays on too. Default: false.
  "keepDisplayAwake": false,

  // Whether new sessions are encrypted: on, off, or asked when each begins. Default: asked at first start. One of: off, on, ask.
  "sessionEncryption": "on",

  // Whether session files are compressed. Default: false.
  "sessionCompression": false,

  // A task list for each session, or one for the workspace. Default: session. One of: session, workspace.
  "taskScope": "session",

  // Whether the key the password opens is kept in the keychain, or the password asked at every start. Default: asked at first start. One of: remember, everyStart.
  "sessionPassword": "remember",

  // Where keys and sign-in tokens are kept. Default: auto. One of: auto, keychain, file. Your own file only.
  "credentials": "auto",

  // Which providers serve a repository, by its path, remote or git identity; the first rule that matches decides. Default: none. Your own file only.
  "modelScopes": [{"path": "~/work", "providers": ["work"]}],

  // Sets of MCP servers ask knows: swift connects apple-docs and swift-search. Default: none.
  "presets": ["swift"],

  "ui": {
    // ask handles clicks, selection and the wheel. Default: true.
    "mouse": true,

    // A finished selection is copied at once. Default: true.
    "copyOnSelect": true,

    // Tinted backgrounds for the input, your messages and tool calls. Default: true.
    "tint": true,

    // A rule between the conversation and the input. Default: true.
    "separator": true,

    // A row of padding around each block. Default: true.
    "padding": true,

    // Markdown drawn everywhere it can be. Default: true.
    "markdown": true,

    // Fenced code coloured by the language its fence names. Default: true.
    "highlight": true,

    // A running block's header shimmers. Default: true.
    "shimmer": true,

    // How faint secondary text is: ask's own grey, or nearer the page (faint, fainter), never below 3:1 contrast. Default: normal. One of: normal, faint, fainter.
    "dim": "normal",

    // The box around the input: the session's colour, lighter, or the grey of secondary text (dim). Default: tint. One of: tint, dim.
    "inputBorder": "tint",

    // What a click acts on brightens under the pointer. Default: true.
    "hover": true,

    // When a job you watch ends, go back to the conversation. Default: true.
    "leaveFinishedJob": true,

    // A colour of the session's own on the status line: always, or only while another ask runs. Default: off. One of: off, always, others.
    "sessionColor": "off",

    // Model lists also show models ask cannot use. Default: false.
    "listAllModels": false,

    "fold": {
      // Tool calls start folded. Default: true.
      "tools": true,

      // The model's reasoning starts folded. Default: true.
      "thinking": true,

      // Long code blocks start folded. Default: true.
      "code": true,

      // How many lines make a code block long. Default: 20.
      "codeLines": 20,

      // A tool's output with more lines than this keeps its head and tail and folds its middle. Default: 200.
      "outputLines": 200,

      // A tool's output with more bytes than this keeps its head and tail and folds its middle. Default: 32768.
      "outputBytes": 32768
    },

    // Lines per wheel step. Default: 3.
    "scrollLines": 3,

    // How many rows the input grows to before it scrolls. Default: 6.
    "inputRows": 6,

    // Whether the runner sidebar starts open. Default: closed. One of: closed, open.
    "sidebar": "closed",

    // Where the sidebar lists a thread's jobs: under the thread, or with every job in the Jobs section. /sidebar jobs switches. Default: tree. One of: tree, section.
    "sidebarJobs": "tree",

    // Where the open sidebar goes: beside the transcript, in the bottom band with the input, or the band where the other would leave the transcript under 100 columns. Default: adaptive. One of: full, bottom, adaptive.
    "sidebarLayout": "adaptive",

    // Text the input line starts with. Default: none.
    "inputPrefix": "> ",

    // Where the tints come from. Default: auto. One of: auto, light, dark.
    "appearance": "auto",

    // Elapsed times as 1 hr, 40 min or as 1:40:00. Default: words. One of: words, clock.
    "durations": "words",

    // The spinner. Default: line. One of: braille, braillefull, braillequarter, snake, line, random.
    "spinner": "line",

    // When a command's timeout is written in its header. Default: auto. One of: auto, always, never.
    "showTimeout": "auto",

    // The word in front of a command's timeout, 1 to 8 characters. Default: timeout.
    "timeoutLabel": "timeout",

    // Which keys stop a running turn. Default: both. One of: esc, ctrl-c, both.
    "stopKeys": "both",

    // The keys that must be pressed twice to stop a turn. Default: ["esc"].
    "stopTwice": ["esc"],

    // What happens to queued messages on a stop. Default: all. One of: none, next, all.
    "queuedOnStop": "all"
  },

  "sandbox": {
    // Where tools and commands may write. Default: workspace.
    "write": "workspace",

    // Where they may read. Default: anywhere.
    "read": "anywhere",

    // How far commands reach. Default: any. One of: none, localhost, provider, any.
    "network": "any",

    // More paths to hide. Default: none.
    "hide": ["~/notes"],

    // Protected paths to make readable again. Default: none. Your own file only.
    "readable": ["~/.aws"],

    // Protected paths to make writable again. Default: none. Your own file only.
    "writable": ["~/.zshrc"]
  },

  "approvals": {
    // What a call no list names does. Default: ask. One of: ask, allow. Your own file only.
    "default": "ask",

    // Tools that run without asking. Default: none. Your own file only.
    "allow": ["mcp__docs__*"],

    // Tools that always ask. Default: none. Your own file only.
    "ask": ["write"],

    // What an "always" answer could write back to this file. Default: none. One of: anything, narrowing, none. Your own file only.
    "remember": "none"
  },

  "hooks": {
    // How many times hooks may continue a run that would have ended; each counts against maxTurns. Default: 3. Your own file only.
    "maxContinues": 3,

    // A command run when a run that changed things would end; a failure is sent back to the model. Default: none.
    "check": "swift test",

    // How many seconds the check may take, from 1 to 600. Default: 600.
    "checkTimeout": 600
  },

  "threads": {
    // How many threads may work at once, from 1 to 16. Default: 4.
    "max": 4,

    // How deep threads may nest, from 1 to 8. Default: 3.
    "depth": 3,

    // How a thread is named: by Apple's on-device model from its task where it is available, by a model, or numbered. Default: onDevice. One of: onDevice, numbered, model.
    "names": "onDevice",

    // The model names "model" asks, as /model takes it ("provider/model" or a model); empty for the conversation's own. Default: the conversation's model.
    "namesModel": "",

    // The model threads work and write their summaries with, as /model takes it; empty for the conversation's own. Default: the conversation's model.
    "model": "provider/model",

    // What a thread's summary should also hold, added after the standard merge instruction. Default: none.
    "summaryInstructions": "List every file you changed.",

    // How long a merged thread stays in the sidebar: "30m", "2h", "1d", or "always". /threads still lists it. Default: 1d.
    "mergedShownFor": "1d",

    // Where a thread's question appears while you are elsewhere: at once, after questionsAfter, or only in its lane. Default: focus. One of: focus, after, lane.
    "questions": "focus",

    // How long "after" waits before showing a thread's question. Default: 30s.
    "questionsAfter": "30s"
  },

  "agents": {
    // Whether the model may start subagents with the agent tool. Only your own config file can turn it on. Default: false. Your own file only.
    "enabled": true,

    // Whether subagents may change files; read-only otherwise. Default: false. Your own file only.
    "allowWrites": true,

    // The most turns one subagent may take, from 1 to 200. Default: 30.
    "maxTurns": 30,

    // Whether other coding tools' agent definitions are read too, from their folders. Only your own config file can turn it on. Default: false. Your own file only.
    "otherHarnesses": true,

    // Whether a cheap model on your connection classifies a definition's model words that no listed model matches. Default: true.
    "resolveWithModel": false
  },

  "skills": {
    // Whether skills are offered; a project's file may only turn them off. Default: true.
    "enabled": true,

    // How many skills are listed to the model. Default: 32. Your own file only.
    "maxListed": 32,

    // Where to look, by harness. Default: every harness. Your own file only.
    "sources": ["agents", "user"]
  },

  "environment": {
    // More variables kept from commands. Default: ask's and well-known credential variables.
    "withhold": ["AWS_*"],

    // Withheld variables commands get anyway. Default: none. Your own file only.
    "pass": ["GH_TOKEN"],

    // The shell commands run in. Default: the first bash on your PATH, else /bin/bash, else ksh, sh or dash, else your login shell. Your own file only.
    "shell": "zsh"
  },

  // MCP servers whose tools are offered to the model, by name (docs/skills-and-mcp.md).
  "mcp": {
    "docs": {"url": "https://example.com/mcp", "enabled": false}
  }
}
